# Son / Base 2: copy this file to run/.env and fill in your own credentials.
# Matches BeeCuriousService/.env.example; change both ports together if needed.
BEECURIOUS_SERVICE_URL=http://127.0.0.1:13161

# Microphone transcription and fallback voice.
OPENAI_API_KEY=
# Optional Typecast voice; leave blank to use the OpenAI fallback.
TYPECAST_API_KEY=

# Low-level Bip behaviours (these are also the code defaults).
BIP_IDLE_WANDER=true
BIP_LOOK_AT_PLAYER=true
BIP_EMOTION_PARTICLES=true
BIP_KICK_REACTION=true
BIP_TIERED_HINTS=true
BIP_TIME_TRAVEL_HANDOVER=true
BIP_INTERACTIVE_QA=true

# Optional telemetry; session consent still controls whether logs are sent.
LOKI_URL=https://loki-beetrap.interplaylab.io
LOKI_USER=beetrap
LOKI_PASSWORD=
